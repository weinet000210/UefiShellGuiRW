[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = UefiShellGuiRW
  FILE_GUID                      = 6B1E7C3A-52D4-4F0E-9C61-3A8D2F5B7E10
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.0.1
  ENTRY_POINT                    = UefiShellGuiRWMain

[Sources]
  UefiShellGuiRW.h
  UefiShellGuiRW.c
  SelfTest.c
  Shell/Commands.c
  Shell/MainFrame.c
  Shell/MenuBar.c
  Shell/Toolbar.c
  Shell/StatusBar.c
  Shell/Mdi.c
  Shell/Icons.c
  SelfTestWidgets.c
  Widgets/RwWidgets.h
  Widgets/Focus.c
  Widgets/Dialog.c
  Widgets/VList.c
  Widgets/InfoViews.c
  Widgets/HexGrid.c
  Widgets/BitField.c
  Widgets/FontMono12.c
  Widgets/FontMono14.c
  Views/Placeholder.c
  Views/About.c
  Views/WidgetTest.h
  Views/WidgetTest.c
  Views/Views.h
  Views/SpaceView.c
  Views/PciView.c
  Views/MemoryView.c
  Views/IoView.c
  Views/IndexDataView.c
  Views/CmosView.c
  Views/MsrView.c
  Views/PcieTreeView.c
  Views/AcpiView.c
  Views/SmbiosView.c
  Views/UsbView.c
  Views/EcView.c
  Views/SioView.c
  Views/ComView.c
  Views/SmbusView.c
  Views/StorageView.c
  Views/EdidView.c
  SelfTestViews.c
  SelfTestDecoders.c
  SelfTestDevices.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  LVGLUefiGuiPkg/LVGLUefiGuiPkg.dec
  UefiShellGuiRWPkg/UefiShellGuiRWPkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiBootServicesTableLib
  UefiLib
  BaseLib
  BaseMemoryLib
  MemoryAllocationLib
  PrintLib
  DebugLib
  LvglLib
  UefiGuiLib
  UefiGuiRuntimeLib
  RwCoreLib

[Protocols]
  gEfiLoadedImageProtocolGuid              ## CONSUMES
  gEfiSerialIoProtocolGuid                 ## SOMETIMES_CONSUMES

[BuildOptions]
  # -ffreestanding: LVGL headers include <stdint.h>; use the compiler's own.
  GCC:*_*_*_CC_FLAGS = -ffreestanding -Wextra -Wno-unused-parameter -Wno-missing-field-initializers
  MSFT:*_*_*_CC_FLAGS = /wd4204
